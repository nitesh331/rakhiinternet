{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://rakhiinternetbackend.onrender.com/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://rakhiinternetbackend.onrender.com"
  }
}